-- =========================================================
-- Ability loop: alternate between two abilities every 3s
-- =========================================================
task.spawn(function()
	local backpack = player:WaitForChild("Backpack")
	local useFirst = true

	while true do
		task.wait(3)

		local ok, err = pcall(function()
			if useFirst then
				-- Ability #1: second child of Backpack
				local tool = backpack:GetChildren()[2]
				if tool and tool:FindFirstChild("abilityEvent") then
					tool.abilityEvent:FireServer()
				end
			else
				-- Ability #2: "Pulse Waves" tool
				local tool = backpack:FindFirstChild("Arrow Rain")
				if tool and tool:FindFirstChild("abilityEvent") then
					tool.abilityEvent:FireServer()
				end
			end
		end)

		if not ok then
			warn("[AbilityLoop] " .. tostring(err))
		end

		useFirst = not useFirst
	end
end)

